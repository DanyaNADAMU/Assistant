[Unit]
Description=SummaryBot Multimodal Telegram Bot Daemon
Documentation=https://git.nada.mu/NADAMU/SummaryBot
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=SummaryBot
Image=git.nada.mu/NADAMU/summary-bot:latest
EnvironmentFile=%h/stacks/SummaryBot/.env

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
