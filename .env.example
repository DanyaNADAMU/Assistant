# OpenRouter API Credentials
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://nada.mu
OPENROUTER_APP_TITLE=SummaryBot

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

# Model Category Mappings (Primary and Fallback)
MODEL_AUDIO_PRIMARY=xiaomi/mimo-v2.6-flash
MODEL_AUDIO_FALLBACK=qwen/qwen3.8-omni-flash

MODEL_TEXT_PRIMARY=thinkingmachines/inkling-2-small:free
MODEL_TEXT_FALLBACK=z-ai/glm-5.3-flash

MODEL_VISION_PRIMARY=thinkingmachines/inkling-2-small:free
MODEL_VISION_FALLBACK=z-ai/glm-5.3-flash

MODEL_MICRO_PRIMARY=z-ai/glm-5.3-flash
MODEL_MICRO_FALLBACK=deepseek/deepseek-v4.1-flash

MODEL_PRO_PRIMARY=z-ai/glm-5.3
MODEL_PRO_FALLBACK=google/gemini-3.8-flash

# Execution Limits and Timeouts
REQUEST_TIMEOUT_SECONDS=90.0
MAX_RETRIES=2
MAX_DOWNLOAD_SIZE_BYTES=52428800  # 50 MB
