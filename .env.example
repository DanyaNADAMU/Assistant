# OpenRouter API Credentials
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://nada.mu
OPENROUTER_APP_TITLE=Assistant

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

# Model Category Mappings (Primary and Fallback)
MODEL_AUDIO_PRIMARY=xiaomi/mimo-v2.6-flash
MODEL_AUDIO_FALLBACK=qwen/qwen3.8-omni-flash

MODEL_TEXT_PRIMARY=thinkingmachines/inkling-2-small:free
MODEL_TEXT_FALLBACK=z-ai/glm-5.3-flash

MODEL_VISION_PRIMARY=thinkingmachines/inkling-2-small:free
MODEL_VISION_FALLBACK=z-ai/glm-5.3-flash

MODEL_MICRO_PRIMARY=z-ai/glm-5.3-flash
MODEL_MICRO_FALLBACK=deepseek/deepseek-v4.1-flash

MODEL_PRO_PRIMARY=z-ai/glm-5.3
MODEL_PRO_FALLBACK=google/gemini-3.8-flash

# Venice.AI — uncensored image/video generation backend
VENICE_API_KEY=CHANGE_ME_VENICE_API_KEY
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Image generation defaults
GEN_IMAGE_MODEL=venice-sd35
GEN_IMAGE_MODEL_PHOTOREAL=flux-3-image
GEN_IMAGE_MODEL_ANIME=wai-Illustrious
GEN_IMAGE_WIDTH=1024
GEN_IMAGE_HEIGHT=1024
GEN_IMAGE_FORMAT=png
GEN_IMAGE_NEGATIVE_PROMPT=blurry, low quality, distorted anatomy, text, watermark

# Video generation defaults
GEN_VIDEO_TEXT_MODEL=wan-2-7-text-to-video
GEN_VIDEO_IMAGE_MODEL=wan-2-7-image-to-video
GEN_VIDEO_DURATION=5s
GEN_VIDEO_RESOLUTION=720p
GEN_VIDEO_ASPECT_RATIO=16:9
GEN_VIDEO_NEGATIVE_PROMPT=low resolution, error, worst quality, low quality, defects
GEN_VIDEO_POLL_INTERVAL=5.0
GEN_VIDEO_TIMEOUT=300.0

# Execution Limits and Timeouts
REQUEST_TIMEOUT_SECONDS=90.0
MAX_RETRIES=2
MAX_DOWNLOAD_SIZE_BYTES=52428800  # 50 MB
